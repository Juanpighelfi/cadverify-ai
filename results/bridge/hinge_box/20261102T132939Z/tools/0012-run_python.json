    "code": "import trimesh, numpy as np, glob\nfrom scipy.spatial import cKDTree\nfiles = sorted(glob.glob('checks/assembly/model.assembly.*.stl'))\nprint(files)\nmeshes={}\nfor f in files:\n    m=trimesh.load(f); meshes[f]=m; print(f, m.bounds, m.volume)\n# identify by volume: box 33602, lid 20358, pin 802\nbox=[m for m in meshes.values() if abs(m.volume-33602)<10][0]\nlid=[m for m in meshes.values() if abs(m.volume-20358)<10][0]\nlidf=lid.copy(); v=lidf.vertices.copy(); v[:,1]=112-v[:,1]; v[:,2]=40-v[:,2]; lidf.vertices=v\nprint('flipped lid bounds', lidf.bounds)\nfor name,a,b in [('box-lidf',box,lidf)]:\n    ta=cKDTree(a.vertices); d,i=ta.query(b.vertices)\n    k=np.argsort(d)[:15]\n    for j in k: print(name, round(float(d[j]),3), 'lidpt', np.round(b.vertices[j],2), 'boxpt', np.round(a.vertices[i[j]],2))\n    tb=cKDTree(b.vertices); d2,i2=tb.query(a.vertices)\n    k=np.argsort(d2)[:10]\n    for j in k: print(name+' rev', round(float(d2[j]),3), 'boxpt', np.round(a.vertices[j],2), 'lidpt', np.round(b.vertices[i2[j]],2))\n"
  },
